---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="contact-line">Email: hello@themoscowwellness.com</p>
		<p class="contact-line">Instagram: @themoscowwellness</p>
		<p class="footer-meta">&copy; {today.getFullYear()} THE MOSCOW WELLNESS</p>
	</div>
</footer>

<style>
	footer {
		padding: 3rem 1.5rem 4.5rem;
		text-align: center;
		color: var(--color-muted);
	}
	.footer-inner {
		display: grid;
		gap: 0.8rem;
		justify-items: center;
	}
	.contact-line {
		margin: 0;
		font-size: 0.95rem;
		letter-spacing: 0.04em;
	}
	.footer-meta {
		margin: 0;
		font-size: 0.82rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}
</style>
