---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const featured = posts.slice(0, 3);
const categories = [
	'Beauty',
	'Food & Drink',
	'Home',
	'Women’s Health',
	'Wellness Culture',
	'Fashion',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Editorial Guide</p>
					<h1>{SITE_TITLE}</h1>
					<p class="tagline">{SITE_DESCRIPTION}</p>
					<p class="intro">
						A quiet edit of Moscow living, bringing low-tox rituals, thoughtful brands, and contemporary
						wellness culture into one warm, calm space.
					</p>
				</div>
			</section>

			<section class="overview">
				<div class="section-heading">
					<span class="section-label">Explore</span>
					<h2>Categories</h2>
				</div>

				<div class="category-grid">
					{categories.map((category) => (
						<a class="category-card" href="#" aria-label={`Explore ${category}`}>
							<span>{category}</span>
						</a>
					))}
				</div>
			</section>

			<section class="featured-guides">
				<div class="section-heading">
					<span class="section-label">Featured Guides</span>
					<h2>Recent editorial notes</h2>
				</div>

				<div class="post-grid">
					{featured.map((post) => (
						<article class="post-card">
							<a href={`/blog/${post.slug}`}>
								<p class="post-meta">
									{new Date(post.data.pubDate).toLocaleDateString('en-US', {
										month: 'short',
										day: 'numeric',
										year: 'numeric',
									})}
								</p>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</a>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
