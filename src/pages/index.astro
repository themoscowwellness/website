---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { Sparkles, Droplet, Leaf, Utensils, Home, HeartPulse, Sprout, Shirt } from '@lucide/astro';

const posts = await getCollection('blog');
const featured = posts.slice(0, 3);
const heroImage = 'https://images.unsplash.com/photo-1501004318641-b39e6451bec6?auto=format&fit=crop&w=1200&q=80';
const featuredImages = [
	'https://images.unsplash.com/photo-1519710164239-da123dc03ef4?auto=format&fit=crop&w=900&q=80',
	'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80',
	'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=900&q=80',
];
const categories = [
	{
		title: 'Beauty',
		icon: Sparkles,
		description: 'Low-tox skincare, natural makeup, and beauty rituals.',
	},
	{
		title: 'Food & Drink',
		icon: Utensils,
		description: 'Healthy eating, clean ingredients, and local spots.',
	},
	{
		title: 'Home',
		icon: Home,
		description: 'Non-toxic living, cleaning, and mindful interiors.',
	},
	{
		title: 'Women’s Health',
		icon: HeartPulse,
		description: 'Hormonal health, cycle awareness, and wellbeing.',
	},
	{
		title: 'Wellness Culture',
		icon: Sprout,
		description: 'Practices, places, and people inspiring a mindful life.',
	},
	{
		title: 'Fashion',
		icon: Shirt,
		description: 'Conscious brands, natural fabrics, and timeless style.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Editorial Guide</p>
					<h1>{SITE_TITLE}</h1>
					<p class="tagline">{SITE_DESCRIPTION}</p>
					<p class="intro">
						Thoughtful recommendations, trusted places, and conscious choices for everyday life.
					</p>
					<a class="primary-button" href="/blog">
						Explore guides
						<span aria-hidden="true">→</span>
					</a>
				</div>
				<div class="hero-visual">
					<img src={heroImage} alt="Still life wellness scene with ceramics and linen" />
				</div>
			</section>

			<section class="overview">
				<div class="section-heading">
					<span class="section-label">Explore</span>
					<h2>Categories</h2>
				</div>

				<div class="category-grid">
					{categories.map((category) => (
						<a class="category-card" href="#" aria-label={`Explore ${category.title}`}>
						<span class="category-icon" aria-hidden="true">
                                                          <component is={category.icon} size={24} strokeWidth={1.5} />
                                                  </span>
							<div>
								<p class="card-title">{category.title}</p>
								<p class="category-description">{category.description}</p>
							</div>
						</a>
					))}
				</div>
			</section>

			<section class="featured-guides">
				<div class="featured-heading">
					<div>
						<span class="section-label">Featured Guides</span>
						<h2>Latest Editorial Notes</h2>
					</div>
					<a class="secondary-link" href="/blog">View all guides →</a>
				</div>

				<div class="post-grid">
					{featured.map((post, index) => (
						<article class="post-card">
							<a href={`/blog/${post.slug}`}>
								<img class="post-image" src={featuredImages[index]} alt={post.data.title} />
								<div class="post-copy">
									<p class="post-meta">
										{new Date(post.data.pubDate).toLocaleDateString('en-US', {
											month: 'short',
											day: 'numeric',
											year: 'numeric',
										})}
									</p>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<p class="read-link">Read guide →</p>
								</div>
							</a>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
